{
  "manifest_version": 3,
  "name": "Agent Tabs",
  "version": "0.1.0",
  "description": "Manually colour individual Chrome tabs using native tab groups.",
  "minimum_chrome_version": "150",
  "permissions": [
    "contextMenus",
    "tabGroups"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
