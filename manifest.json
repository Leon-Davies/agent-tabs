{
  "manifest_version": 3,
  "name": "Agent Tabs",
  "version": "0.1.0",
  "description": "Add purely visual colour markers to individual Chrome tabs.",
  "minimum_chrome_version": "150",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
